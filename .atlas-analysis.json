  "keyFeatures": [
    "Persistent memory across coding agent sessions",
    "Multi-agent knowledge unification (Claude Code, Cursor, Codex, OpenCode)",
    "Automatic extraction of decisions and learnings using DSPy pipelines",
    "Memory refinement with merging, archiving, and time-based decay",
    "File-first markdown storage with YAML frontmatter",
    "Docker service architecture with HTTP API and dashboard",
    "Natural language memory querying",
    "Project-scoped memory with global fallback"
  ],
  "publicApiSurface": [
